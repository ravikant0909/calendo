# Copy to .dev.vars for local dev (`npx wrangler dev`). In production set each
# one with `npx wrangler secret put NAME`. Only the first block is required.

# --- Required ---
APP_ORIGIN=http://127.0.0.1:8787
# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Signs OAuth "state". Generate: openssl rand -base64 32
OAUTH_STATE_SECRET=
# Comma-separated emails that can open /admin/
ADMIN_EMAIL=you@example.com

# --- Local dev conveniences (do NOT set in production) ---
# AUTH_AUTOCONFIRM=1
# DISABLE_OUTBOUND_NOTIFICATIONS=1
# DISABLE_RATE_LIMITS=1

# --- Email (Resend) — needed for confirmations, reminders, password reset ---
RESEND_API_KEY=

# --- Sign in with Google + Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Microsoft + Outlook / Teams ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Zoom (per-user OAuth app) ---
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- AI agent (Anthropic). Users can also bring their own key in Settings. ---
ANTHROPIC_API_KEY=

# --- Paid bookings / Pro plan (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- SMS reminders (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
